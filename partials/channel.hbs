{{!-- Gedeelde kanaallijst: index.hbs met een eigen kop. Bulletin's eigen
      markup en klassen, alleen de titel en de omschrijving verschillen. --}}
<main id="gh-main" class="gh-main gh-canvas">
    <section class="gh-pagehead">
        <header class="gh-pagehead-content">
            <h1 class="gh-pagehead-title">{{title}}</h1>
            <div class="gh-pagehead-description">{{description}}</div>
        </header>
    </section>

    <div class="gh-feed">
        {{#foreach posts}}
            {{> "loop"}}
        {{/foreach}}
    </div>
</main>
