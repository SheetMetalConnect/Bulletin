<article class="gh-article {{post_class}}">
    <header class="gh-article-header gh-canvas{{#match @custom.feature_image_width "Full"}} image-full{{else match @custom.feature_image_width "=" "Wide"}} image-wide{{/match}}">
        <h1 class="gh-article-title">{{title}}</h1>

        <span class="gh-article-meta">
            {{#if primary_tag}}
                <a class="gh-article-tag" href="{{primary_tag.url}}">{{primary_tag.name}}</a>
                —
            {{/if}}
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
            <span class="gh-article-readtime"> · {{reading_time}}</span>
        </span>

        {{#if custom_excerpt}}
            <p class="gh-article-excerpt">{{custom_excerpt}}</p>
        {{/if}}

        <div class="gh-meta-share">
            <a href="#/share" class="gh-button-share">{{t "Share"}} {{> "icons/share"}}</a>
        </div>

        {{> "feature-image"}}
    </header>

    <div class="gh-content gh-canvas">
        {{content}}
    </div>

    {{#is "post"}}
        {{#has tag="guides,#archive-nl,#archive-de"}}
            <section class="gh-canvas">
                <aside class="lve-disclaimer">
                    {{#has tag="#archive-de"}}
                        <p><strong>Haftungsausschluss:</strong> Kostenlose, allgemeine Information von Sheet Metal Connect e.U., keine maßgeschneiderte Beratung. Produkte, Preise und Angaben ändern sich und können Fehler oder Auslassungen enthalten. Führen Sie Ihre eigene Prüfung durch und wenden Sie sich direkt an die Anbieter. Sheet Metal Connect e.U. übernimmt keine Haftung für Schäden, die aus der Nutzung dieser Informationen entstehen. Für einen auf Ihre Fabrik zugeschnittenen Plan, siehe die <a href="/services/">Beratung</a>.</p>
                    {{else}}{{#has tag="#archive-nl"}}
                        <p><strong>Disclaimer:</strong> Gratis, algemene informatie van Sheet Metal Connect e.U., geen advies op maat. Producten, prijzen en gegevens veranderen en kunnen fouten of omissies bevatten. Doe je eigen onderzoek en raadpleeg leveranciers rechtstreeks. Sheet Metal Connect e.U. aanvaardt geen aansprakelijkheid voor enige schade die voortvloeit uit het gebruik van deze informatie. Voor een plan op maat, zie de <a href="/services/">consulting</a>.</p>
                    {{else}}
                        <p><strong>Disclaimer:</strong> This is free, general information published by Sheet Metal Connect e.U., not tailored advice. Products, prices, and specifications change and content may contain errors or omissions. Conduct your own due diligence and consult vendors directly. Sheet Metal Connect e.U. accepts no liability for any loss or damage arising from use of this information. For a plan tailored to your factory, see the <a href="/services/">consulting</a>.</p>
                    {{/has}}{{/has}}
                </aside>
            </section>
        {{/has}}

        {{#unless @member}}
            <section class="gh-canvas">
                <div class="lve-cta">
                    <h3 class="lve-cta-title">Want to connect your first machine?</h3>
                    <p class="lve-cta-text">Join free and I'll show you how. You get my members-only starter guide plus the fill-in templates and downloads you'll actually use.</p>
                    <a class="lve-btn" href="#/portal/signup" data-portal="signup">Get access now</a>
                </div>
            </section>
        {{/unless}}

        {{#primary_author}}
            <section class="gh-canvas">
                <div class="lve-author">
                    {{#if profile_image}}
                        <img class="lve-author-img" src="{{profile_image}}" alt="{{name}}">
                    {{/if}}
                    <div class="lve-author-body">
                        <p class="lve-author-name">{{name}}</p>
                        {{#if bio}}<p class="lve-author-bio">{{bio}}</p>{{/if}}
                    </div>
                </div>
            </section>
        {{/primary_author}}
    {{/is}}

    {{#is "post"}}
        {{#if comments}}
            <div class="gh-comments gh-canvas">
                {{comments}}
            </div>
        {{/if}}
    {{/is}}

    <footer class="gh-article-footer gh-canvas{{#prev_post}} has-prev{{/prev_post}}{{#next_post}} has-next{{/next_post}}{{#if @site.comments_enabled}}{{#unless @member}} no-border{{/unless}}{{#unless access}} no-border{{/unless}}{{/if}}">
        <nav class="gh-navigation">

            <div class="gh-navigation-previous">
                {{#prev_post}}
                    <a class="gh-navigation-link" href="{{url}}">
                        {{> icons/arrow-left}} <span class="gh-navigation-hide">{{t "Previous issue"}}</span>
                    </a>
                {{/prev_post}}
            </div>

            <div class="gh-navigation-middle">
                {{#get "posts" fields="id" limit="10" page="2" as |secondPage|}}
                    {{#if secondPage}}
                        <a class="gh-navigation-link" href="/page/2">{{t "Browse archive"}}</a>
                    {{/if}}
                {{/get}}
            </div>

            <div class="gh-navigation-next">
                {{#next_post}}
                    <a class="gh-navigation-link" href="{{url}}">
                        <span class="gh-navigation-hide">{{t "Next issue"}}</span> {{> icons/arrow-right}}
                    </a>
                {{/next_post}}
            </div>

        </nav>
    </footer>
</article>