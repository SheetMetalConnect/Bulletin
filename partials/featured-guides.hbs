{{!-- LVE: featured guides strip — renders only when posts are marked Featured in admin --}}
{{#get "posts" filter="featured:true" limit="6" as |featured|}}
    {{#if featured}}
        <section class="gh-featured-guides">
            <h3 class="gh-featured-guides-title">{{t "Featured guides"}}</h3>
            <div class="gh-featured-guides-grid">
                {{#foreach featured}}
                    <a class="gh-featured-guide" href="{{url}}">
                        {{#if feature_image}}
                            <img src="{{img_url feature_image size="s"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy">
                        {{/if}}
                        <span>{{title}}</span>
                    </a>
                {{/foreach}}
            </div>
        </section>
    {{/if}}
{{/get}}
