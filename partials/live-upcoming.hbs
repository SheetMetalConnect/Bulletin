{{!-- Aankomende uitzending. Eén bron van waarheid: de post met tag `live` die nog
      het interne merk #aankomend draagt. published_at IS het uitzendmoment van een
      livestream, dus de datum hoeft nergens apart bijgehouden te worden. Na de
      uitzending haalt Luke #aankomend eraf en verdwijnt dit blok vanzelf. --}}
{{#get "posts" filter="tag:live+tag:hash-aankomend" limit="1" order="published_at asc"}}
    {{#foreach posts}}
        <aside class="lve-live-next">
            <span class="lve-live-eyebrow"><span class="lve-live-dot"></span>Aankomende uitzending</span>
            <a class="lve-live-title" href="{{url}}">{{title}}</a>
            <time class="lve-live-when" datetime="{{date format="YYYY-MM-DDTHH:mm"}}">{{date format="D MMMM YYYY"}} om {{date format="HH:mm"}} uur</time>
        </aside>
    {{/foreach}}
{{/get}}
