{{!-- Aankomende uitzending, als tegenhanger van het "NIEUWSTE ARTIKEL"-label in de
      rechterkolom: dezelfde pil (.gh-home-latest-label + .gh-home-latest-indicator),
      hier op de accentkleur. Titel op de maat van .gh-home-logo, datum op die van
      .gh-home-description — geen eigen typografie, alleen bestaande stappen.

      Eén bron van waarheid: de post met tag `live` die nog het interne merk
      #aankomend draagt. published_at IS het uitzendmoment, dus de datum hoeft
      nergens apart bijgehouden te worden. Na de uitzending haalt Luke #aankomend
      eraf en verdwijnt dit blok vanzelf. --}}
{{#get "posts" filter="tag:live+tag:hash-aankomend" limit="1" order="published_at asc"}}
    {{#foreach posts}}
        <aside class="lve-live-next">
            <span class="gh-home-latest-label lve-live-label">
                <span class="gh-home-latest-indicator"></span>Aankomende uitzending
            </span>
            <a class="lve-live-title" href="{{url}}">{{title}}</a>
            <time class="lve-live-when" datetime="{{date format="YYYY-MM-DDTHH:mm"}}">{{date format="D MMMM YYYY"}} om {{date format="HH:mm"}} uur</time>
        </aside>
    {{/foreach}}
{{/get}}
