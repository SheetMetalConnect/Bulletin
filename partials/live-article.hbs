{{!-- Een aflevering van Metaal Connect LIVE is geen artikel: een uitzendmoment, en na
      afloop de opname. Eén post, twee toestanden, dezelfde URL. Het interne merk
      #aankomend bepaalt welke. Geen kaart of kader, want de kop van dit thema is een
      gecentreerde stapel en dit hoort daar gewoon in mee te lopen. --}}
<article class="gh-article {{post_class}} lve-live-post">
    <header class="gh-article-header gh-canvas">
        <span class="lve-live-eyebrow">
            <span class="lve-live-dot"></span>
            {{#has tag="#aankomend"}}Aankomende uitzending{{else}}Metaal Connect LIVE{{/has}}
        </span>

        <h1 class="gh-article-title">{{title}}</h1>

        <div class="lve-live-when">
            <span class="lve-live-when-label">{{#has tag="#aankomend"}}Live op{{else}}Uitgezonden{{/has}}</span>
            <time datetime="{{date format="YYYY-MM-DDTHH:mm"}}">{{date format="D MMMM YYYY"}} om {{date format="HH:mm"}} uur</time>
        </div>

        {{#has tag="#aankomend"}}
            <p class="lve-live-watch">Kijk mee op {{> "live-watch"}}</p>
            {{#unless @member}}
                <a class="lve-btn lve-live-cta" href="#/portal/signup" data-portal="signup">Stuur me een herinnering</a>
            {{/unless}}
        {{/has}}

        <div class="gh-meta-share">
            <a href="#/share" class="gh-button-share">{{t "Share"}} {{> "icons/share"}}</a>
        </div>

        {{> "feature-image"}}
    </header>

    <div class="gh-content gh-canvas">
        {{content}}
    </div>

    {{> "subscribe-cta" title="Geen uitzending missen?" text="Ik kondig elke uitzending vooraf aan in de mail."}}

    <footer class="gh-article-footer gh-canvas">
        <nav class="gh-navigation">
            <div class="gh-navigation-previous">
                {{#prev_post in="primary_tag"}}
                    <a class="gh-navigation-link" href="{{url}}">
                        {{> icons/arrow-left}} <span class="gh-navigation-hide">Vorige aflevering</span>
                    </a>
                {{/prev_post}}
            </div>
            <div class="gh-navigation-middle">
                <a class="gh-navigation-link" href="/live/">Alle afleveringen</a>
            </div>
            <div class="gh-navigation-next">
                {{#next_post in="primary_tag"}}
                    <a class="gh-navigation-link" href="{{url}}">
                        <span class="gh-navigation-hide">Volgende aflevering</span> {{> icons/arrow-right}}
                    </a>
                {{/next_post}}
            </div>
        </nav>
    </footer>
</article>
