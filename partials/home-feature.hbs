{{!-- Het stuk dat de voorpagina groot laat zien: óf de aankomende uitzending, óf het
      nieuwste artikel. Nooit allebei. Dezelfde opbouw als Bulletin die had, met één
      verschil: bij een uitzending staat het uitzendmoment onder de titel in plaats van
      de publicatiedatum, want dat is de informatie waar je op dat moment op afgaat. --}}
<article class="gh-article {{post_class}}">
    <header class="gh-article-header">
        <h2 class="gh-article-title">{{title}}</h2>
        {{#match primary_tag.slug "live"}}
            <span class="gh-article-meta lve-live-meta">
                <time datetime="{{date format="YYYY-MM-DDTHH:mm"}}">{{date format="DD MMM YYYY"}} · {{date format="HH:mm"}}</time>
                {{> "live-watch"}}
            </span>
        {{else}}
            <span class="gh-article-meta">
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
            </span>
        {{/match}}
    </header>

    {{> "feature-image"}}

    <div class="gh-content">
        {{content}}
    </div>
</article>

<footer class="gh-home-latest-footer">
    <a class="gh-btn" href="{{url}}">
        {{#match primary_tag.slug "live"}}Bekijk de uitzending{{else}}{{t "Read latest issue"}}{{/match}}
    </a>
</footer>
