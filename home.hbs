{{!< default}}

<main id="gh-main" class="gh-main">
    {{#if @site.members_enabled}}
        {{#unless @member}}
            <div class="gh-home">
                <div class="gh-home-cta">
                        <header class="gh-home-head">
                            <div class="gh-home-brand">
                                <a class="gh-home-logo" href="{{@site.url}}">
                                    {{#if @site.logo}}
                                        <img src="{{@site.logo}}" alt="{{@site.title}}">
                                    {{else}}
                                        {{@site.title}}
                                    {{/if}}
                                </a>
                                <p class="gh-home-description">{{@site.description}}</p>
                            </div>
                            <button class="gh-search gh-icon-btn" aria-label="{{t "Search this site"}}" data-ghost-search>{{> "icons/search"}}</button>
                        </header>

                    <section class="gh-home-subscribe">
                        <h2 class="gh-home-subscribe-title">{{t "Stay tuned"}}</h2>
                        <p class="gh-home-subscribe-description">{{t "Don’t miss out on the latest issues. Sign up now to get access to the library of members-only issues."}}</p>
                        <a class="gh-home-subscribe-input" href="#/portal/signup" data-portal="signup">
                            {{t "jamie@example.com"}} <span>{{> icons/arrow-right}}</span>
                        </a>
                    </section>

                    <footer class="gh-home-footer">
                        <div class="gh-social-links">
                            {{#social_accounts @site}}
                                <a href="{{href}}" target="_blank" rel="noopener" aria-label="{{name}}">
                                    {{#> (concat "icons/" type)}}
                                        {{!-- Fallback when no per-platform icon partial exists --}}
                                        <span>{{name}}</span>
                                    {{/undefined}}
                                </a>
                            {{/social_accounts}}
                        </div>
                        <p class="gh-home-copyright">Luke van Enkhuizen · Sheet Metal Connect e.U. © {{date format="YYYY"}}</p>
                    </footer>
                </div>

                <div class="gh-home-latest">
                    {{!-- Staat er een uitzending op de rol, dan is dát het nieuws op de
                          voorpagina. Zo niet, dan het nieuwste artikel. --}}
                    {{#get "posts" filter="tag:live+tag:hash-aankomend" limit="1" include="tags" as |uitzending|}}
                        <section class="gh-home-latest-wrapper">
                            {{#if @site.icon}}
                                <img class="gh-home-latest-icon" src="{{@site.icon}}" alt="{{@site.title}}">
                            {{/if}}

                            {{#if uitzending}}
                                {{#foreach uitzending}}{{> "home-feature"}}{{/foreach}}
                            {{else}}
                                {{#foreach posts limit="1"}}{{> "home-feature"}}{{/foreach}}
                            {{/if}}
                        </section>

                        <div class="gh-home-latest-label">
                            <span class="gh-home-latest-indicator"></span>
                            {{#if uitzending}}Aankomende uitzending{{else}}{{t "Latest issue"}}{{/if}}
                        </div>
                    {{/get}}
                </div>
            </div>
        {{else}}
            {{#get "posts" filter="tag:live+tag:hash-aankomend" limit="1" include="tags" as |uitzending|}}
                {{#if uitzending}}
                    {{#foreach uitzending}}{{> "article"}}{{/foreach}}
                {{else}}
                    {{#foreach posts limit="1"}}{{> "article"}}{{/foreach}}
                {{/if}}
            {{/get}}
        {{/unless}}
    {{else}}
            {{#get "posts" filter="tag:live+tag:hash-aankomend" limit="1" include="tags" as |uitzending|}}
            {{#if uitzending}}
                {{#foreach uitzending}}{{> "article"}}{{/foreach}}
            {{else}}
                {{#foreach posts limit="1"}}{{> "article"}}{{/foreach}}
            {{/if}}
        {{/get}}
    {{/if}}
</main>